<% if (posts.length) { %>
  <% posts.forEach(function(post, index) { %>
  <article class="post-card">
    <div class="post-card__header">
      <a href="/profile/<%= post.author.username %>" class="post-card__author">
        <img class="avatar-tiny" src="<%= post.author.avatar %>" alt="" />
        <span><%= post.author.username %></span>
      </a>
    </div>

    <% if (post.media && post.media.length) { %>
    <a href="/post/<%= post._id %>" class="post-card__media-preview">
      <% if (post.media[0].type === 'video') { %>
      <video muted playsinline preload="metadata" src="<%= post.media[0].url %>"></video>
      <span class="post-card__media-badge"><i class="fas fa-play"></i></span>
      <% } else { %>
      <img src="<%= post.media[0].url %>" alt="" loading="lazy" />
      <% } %>
    </a>
    <% } %>

    <div class="post-card__content">
      <% if (post.body && post.body.trim()) { %>
      <a href="/post/<%= post._id %>" class="post-card__excerpt-link">
        <p class="post-card__excerpt"><%= getPostExcerpt(post, 160) %></p>
      </a>
      <% } else { %>
      <a href="/post/<%= post._id %>" class="post-card__excerpt-link">
        <p class="post-card__excerpt post-card__excerpt--muted"><%= getPostExcerpt(post) %></p>
      </a>
      <% } %>
    </div>

    <div class="post-card__footer">
      <span class="post-card__date">
        <%= post.createdDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      </span>
      <%- include('postLike', { post: post }) %>
    </div>
  </article>
  <% }) %>
<% } else { %>
  <div class="feed-empty">
    <h2><%= emptyTitle %></h2>
    <p><%= emptyMessage %></p>
  </div>
<% } %>