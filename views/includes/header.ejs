<!DOCTYPE html>
<html lang="fr" data-theme="<%= theme %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>
      <%= typeof(title) == "undefined" ? 'SocialNet' : `${title} | SocialNet` %>
    </title>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
      integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO"
      crossorigin="anonymous"
    />
    <script
      defer
      src="https://use.fontawesome.com/releases/v5.5.0/js/all.js"
      integrity="sha384-GqVMZRt5Gn7tB9D9q7ONtcp4gtHIUEW/yG7h98J7IpE3kpi+srfFyyB/04OV6pG0"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/main.css" />
  </head>
  <body>
    <header class="app-header<%= user ? '' : ' app-header--guest' %>">
      <div class="app-header__inner container--app">
        <a href="/" class="app-logo">SocialNet</a>

        <% if(user){ %>
        <div class="app-header__actions">
          <a href="#" class="header-search-icon app-icon-btn"
            ><i class="fas fa-search"></i
          ></a>
          <a href="/messages" class="header-messages-icon app-icon-btn app-icon-btn--badge" title="Messages">
            <i class="far fa-paper-plane"></i>
            <span class="header-badge header-badge--dm<%= unreadDmCount > 0 ? '' : ' header-badge--hidden' %>">
              <%= unreadDmCount > 9 ? '9+' : unreadDmCount %>
            </span>
          </a>
          <a href="/notifications" class="header-activity-icon app-icon-btn app-icon-btn--badge" title="Notifications">
            <i class="far fa-heart"></i>
            <span class="header-badge header-badge--activity<%= unreadActivityCount > 0 ? '' : ' header-badge--hidden' %>">
              <%= unreadActivityCount > 9 ? '9+' : unreadActivityCount %>
            </span>
          </a>
          <a href="/create-post" class="app-icon-btn" title="Nouveau post"
            ><i class="far fa-plus-square"></i
          ></a>
          <a href="/profile/<%= user.username %>" class="app-avatar-link" title="Mon profil"
            ><img src="<%= user.avatar %>" alt="<%= user.username %>"
          /></a>
          <form action="/logout" method="POST" class="app-logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="app-logout-btn">Déconnexion</button>
          </form>
        </div>
        <% } else { %>
        <div class="app-header__guest-actions">
          <form action="/login" method="POST" class="header-login mb-0" aria-label="Connexion">
            <div class="header-login__fields">
              <input
                name="username"
                class="form-control form-control-sm header-login__input"
                type="text"
                placeholder="Identifiant"
                autocomplete="username"
              />
              <input
                name="password"
                class="form-control form-control-sm header-login__input"
                type="password"
                placeholder="Mot de passe"
                autocomplete="current-password"
              />
            </div>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn-instagram btn-sm header-login__submit">
              Connexion
            </button>
          </form>
          <a href="/register" class="btn-instagram-outline header-register-btn">Inscription</a>
        </div>
        <% } %>
      </div>
    </header>