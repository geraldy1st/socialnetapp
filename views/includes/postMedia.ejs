<% if (post.media && post.media.length) { %>
  <% post.media.forEach(function(item) { %>
    <% if (item.type === 'video') { %>
    <div class="post-media post-media--video">
      <video controls playsinline preload="metadata" src="<%= item.url %>"></video>
    </div>
    <% } else { %>
    <div class="post-media post-media--image">
      <img src="<%= item.url %>" alt="Média de la publication" loading="lazy" />
    </div>
    <% } %>
  <% }) %>
<% } %>