<% if (user) { %>
<button
  type="button"
  class="like-button <%= post.isLikedByVisitor ? 'like-button--active' : '' %>"
  data-post-id="<%= post._id %>"
  aria-label="Aimer cette publication"
>
  <i class="<%= post.isLikedByVisitor ? 'fas' : 'far' %> fa-heart"></i>
  <span class="like-button__count"><%= post.likeCount || 0 %></span>
</button>
<% } else { %>
<span class="like-button like-button--readonly">
  <i class="far fa-heart"></i>
  <span class="like-button__count"><%= post.likeCount || 0 %></span>
</span>
<% } %>