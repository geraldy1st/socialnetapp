<%- include('includes/header') %>

<main class="page-main">
  <div class="container--narrow">
    <%- include('includes/flash') %>

    <article class="post-detail">
      <div class="post-detail__header">
        <% if (post.isVisitorOwner) { %>
        <div class="post-detail__actions">
          <a href="/post/<%= post._id %>/edit" title="Modifier"
            ><i class="fas fa-edit"></i
          ></a>
          <form
            class="d-inline"
            action="/post/<%= post._id %>/delete"
            method="POST"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="delete-post-button" title="Supprimer">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </div>
        <% } %>
      </div>

      <div class="post-detail__meta">
        <a href="/profile/<%= post.author.username %>">
          <img class="avatar-tiny" src="<%= post.author.avatar %>" alt="" />
        </a>
        <a href="/profile/<%= post.author.username %>" class="username"
          ><%= post.author.username %></a
        >
        <span class="date"
          >· <%= post.createdDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span
        >
        <% if (post.visibility === 'private' && post.isVisitorOwner) { %>
        <span class="post-visibility-badge"
          ><i class="fas fa-lock"></i> Privé</span
        >
        <% } %>
      </div>

      <%- include('includes/postMedia', { post: post }) %>

      <% if (post.body && post.body.trim()) { %>
      <div class="post-detail__body body-content">
        <%- filterUserHTML(post.body) %>
      </div>
      <% } %>

      <div class="post-detail__likes">
        <%- include('includes/postLike', { post: post }) %>
      </div>
    </article>
  </div>
</main>

<%- include('includes/footer') %>