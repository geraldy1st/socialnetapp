<%- include('includes/header') %>

<main class="page-main">
  <div class="container--narrow">
    <%- include('includes/flash') %>
    <%- include('includes/profileShared') %>

    <div class="user-list">
      <% following.forEach(function(person) { %>
      <a href="/profile/<%= person.username %>" class="user-list__item">
        <img class="avatar-tiny" src="<%= person.avatar %>" alt="" />
        <%= person.username %>
      </a>
      <% }) %>
    </div>
  </div>
</main>

<%- include('includes/footer') %>