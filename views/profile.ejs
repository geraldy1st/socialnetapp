<%- include('includes/header') %>

<main class="page-main">
  <div class="container--narrow">
    <%- include('includes/flash') %>
    <%- include('includes/profileShared') %>

    <div class="profile-grid">
      <% posts.forEach(function(post) { %>
      <a href="/post/<%= post._id %>" class="profile-grid__item">
        <% if (post.visibility === 'private' && isVisitorsProfile) { %>
        <span class="profile-grid__badge"><i class="fas fa-lock"></i></span>
        <% } %>
        <span class="profile-grid__title"><%= post.title %></span>
      </a>
      <% }) %>
    </div>
  </div>
</main>

<%- include('includes/footer') %>