<%- include('includes/header') %>

<main class="guest-home">
  <section class="guest-home__intro">
    <p class="guest-home__eyebrow">Fil public</p>
    <h1 class="guest-home__title">Découvrez la communauté</h1>
    <p class="guest-home__subtitle">
      Parcourez les publications publiques. Connectez-vous ou inscrivez-vous pour
      publier, suivre et discuter.
    </p>
  </section>

  <section class="guest-home__feed">
    <div class="guest-home__feed-inner">
      <%- include('includes/flash') %>
      <%- include('includes/postFeed', {
        posts: posts,
        emptyTitle: 'Aucune publication publique',
        emptyMessage: 'Soyez le premier à partager quelque chose avec la communauté.'
      }) %>
    </div>
  </section>
</main>

<%- include('includes/footer') %>