<%- include('includes/header') %>

<main class="page-main">
  <div class="container--narrow">
    <%- include('includes/flash') %>

    <div class="form-card">
      <h2 class="h5 font-weight-bold mb-4">Nouvelle publication</h2>
      <form action="/create-post" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label for="post-body">Légende</label>
          <textarea
            name="body"
            id="post-body"
            class="body-content tall-textarea form-control"
            placeholder="Écrivez une légende (optionnel si vous ajoutez un média)…"
          ></textarea>
        </div>

        <div class="form-group">
          <label for="post-media">Image ou vidéo</label>
          <input
            type="file"
            name="media"
            id="post-media"
            class="form-control-file profile-edit-file"
            accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime"
          />
          <small class="text-muted d-block mt-1">
            Images compressées automatiquement (WebP). Vidéos MP4/WebM — 15 Mo max.
            Stockage local gratuit.
          </small>
        </div>

        <div class="form-group">
          <label>Visibilité</label>
          <div class="visibility-options">
            <label class="visibility-option">
              <input type="radio" name="visibility" value="public" checked />
              <span class="visibility-option__content">
                <strong>Public</strong>
                <small>Visible par tous, y compris les personnes qui ne vous suivent pas</small>
              </span>
            </label>
            <label class="visibility-option">
              <input type="radio" name="visibility" value="private" />
              <span class="visibility-option__content">
                <strong>Privé</strong>
                <small>Visible uniquement par vos abonnés</small>
              </span>
            </label>
          </div>
        </div>

        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-instagram">Publier</button>
      </form>
    </div>
  </div>
</main>

<%- include('includes/footer') %>