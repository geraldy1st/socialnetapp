<%- include('includes/header') %>

<main class="page-main">
  <div class="container--narrow">
    <%- include('includes/flash') %>

    <a class="small text-muted d-inline-block mb-3" href="/post/<%= post._id %>"
      >&larr; Retour au post</a
    >

    <div class="form-card">
      <h2 class="h5 font-weight-bold mb-4">Modifier la publication</h2>
      <form
        action="/post/<%= post._id %>/edit"
        method="POST"
        enctype="multipart/form-data"
      >
        <% if (post.media && post.media.length) { %>
        <div class="post-edit-current-media">
          <%- include('includes/postMedia', { post: post }) %>
          <input type="hidden" name="removeMedia" id="remove-media" value="false" />
          <button type="button" class="btn btn-instagram-outline btn-sm" id="remove-media-btn">
            Supprimer le média
          </button>
        </div>
        <% } %>

        <div class="form-group">
          <label for="post-body">Légende</label>
          <textarea
            name="body"
            id="post-body"
            class="body-content tall-textarea form-control"
            placeholder="Écrivez une légende…"
          ><%= post.body %></textarea>
        </div>

        <div class="form-group">
          <label for="post-media">Remplacer par une nouvelle image ou vidéo</label>
          <input
            type="file"
            name="media"
            id="post-media"
            class="form-control-file profile-edit-file"
            accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime"
          />
        </div>

        <div class="form-group">
          <label>Visibilité</label>
          <div class="visibility-options">
            <label class="visibility-option">
              <input
                type="radio"
                name="visibility"
                value="public"
                <%= post.visibility !== 'private' ? 'checked' : '' %>
              />
              <span class="visibility-option__content">
                <strong>Public</strong>
                <small>Visible par tous, y compris les personnes qui ne vous suivent pas</small>
              </span>
            </label>
            <label class="visibility-option">
              <input
                type="radio"
                name="visibility"
                value="private"
                <%= post.visibility === 'private' ? 'checked' : '' %>
              />
              <span class="visibility-option__content">
                <strong>Privé</strong>
                <small>Visible uniquement par vos abonnés</small>
              </span>
            </label>
          </div>
        </div>

        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-instagram">Enregistrer</button>
      </form>
    </div>
  </div>
</main>

<script>
  (function () {
    var btn = document.getElementById('remove-media-btn');
    var field = document.getElementById('remove-media');
    if (btn && field) {
      btn.addEventListener('click', function () {
        field.value = 'true';
        btn.closest('form').submit();
      });
    }
  })();
</script>

<%- include('includes/footer') %>